{
  "permissions": {
    "allow": [
      "WebFetch(domain:www.skeleton.dev)",
      "Bash(npx sv create:*)",
      "Bash(npm init:*)",
      "Bash(npm install)",
      "Bash(npm run build:*)",
      "WebSearch",
      "Bash(curl:*)",
      "Bash(npx playwright install:*)",
      "Bash(npm run screenshot:*)",
      "Bash(pkill:*)",
      "Bash(taskkill:*)",
      "Bash(timeout /t 5 /nobreak:*)",
      "Bash(timeout /t 8 /nobreak)",
      "Bash(powershell -Command \"Start-Sleep -Seconds 8\")",
      "Bash(npm run dev:*)",
      "Bash(powershell -Command \"Start-Sleep -Seconds 5; Invoke-WebRequest -Uri ''http://localhost:5173'' -UseBasicParsing -TimeoutSec 5 | Select-Object -ExpandProperty StatusCode\")",
      "Bash(node scripts/capture-screenshot.js:*)",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_run_code",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_evaluate",
      "mcp__playwright__browser_close",
      "Bash(timeout:*)",
      "mcp__playwright__browser_press_key",
      "Bash(xargs cat:*)",
      "Bash(npm run check:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "playwright"
  ]
}
